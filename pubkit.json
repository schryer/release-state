{
  "kind": "utility",
  "protect": {
    "checks": [
      "state / valid",
      "integrations / scan"
    ],
    "tags": false,
    "queue": false,
    "auto_merge": true
  },
  "github_app": {
    "id": {
      "from": "schryer-release-reader-app-id",
      "to": "RELEASE_READER_APP_ID"
    },
    "installation_id": {
      "from": "schryer-release-reader-installation-id",
      "to": "RELEASE_READER_APP_INSTALLATION_ID"
    },
    "key": {
      "from": "schryer-release-reader-app-key",
      "to": "RELEASE_READER_APP_KEY"
    }
  },
  "secrets": [
    {
      "from": "schryer-release-protect-app-id",
      "to": "RELEASE_PROTECT_APP_ID",
      "kind": "variable",
      "environment": "apply"
    },
    {
      "from": "schryer-release-protect-app-key",
      "to": "RELEASE_PROTECT_APP_KEY",
      "kind": "secret",
      "environment": "apply"
    }
  ]
}
